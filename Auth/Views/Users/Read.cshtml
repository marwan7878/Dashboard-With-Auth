@model ReadUserViewModel
@{
    ViewData["Title"] = "Read User";
}


<div class="row" style="justify-content:center">
    <div class="col-md-6">
        <h1>@ViewData["Title"]</h1>
        <hr />
        <div class="form-floating mb-3">
            <input asp-for="FirstName" class="form-control" aria-required="true" placeholder="" maxlength="100" readonly />
            <label asp-for="FirstName">FirstName</label>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="LastName" class="form-control" aria-required="true" placeholder="" maxlength="100" readonly />
            <label asp-for="LastName">LastName</label>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" readonly />
            <label asp-for="Email">Email</label>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Username" class="form-control" autocomplete="username" aria-required="true" placeholder="" readonly />
            <label asp-for="Username">User Name</label>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Role" class="form-control" autocomplete="Role" aria-required="true" readonly />
            <label asp-for="Role">Role</label>
        </div>
        <a asp-controller="Users" asp-action="Index" class="w-100 btn btn-lg btn-secondary">Back</a>
    </div>
</div>
