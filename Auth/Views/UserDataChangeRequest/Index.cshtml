@model List<UnapprovedUserData>


@{
    ViewData["Title"] = "UnapprovedUserData";
}
<h1>UnapprovedUserData</h1>


<table class="table table-striped mt-4">
    <thead>
        <tr class="bg-primary text-white">
            <th>First Name</th>
            <th>Last Name</th>
            <th>User Name</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (UnapprovedUserData user in Model)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Username</td>
                <td>@user.Email</td>
                <td>
                    <button type="button" class="btn btn-success mx-2 col-sm-2" onclick="approveUser('@user.Id')">Approve</button>
                    <button type="button" class="btn btn-danger mx-2 col-sm-2" onclick="rejectUser('@user.Id')">Reject</button>
                    <a class="btn btn-primary" asp-controller="UserDataChangeRequest" asp-action="Show" asp-route-id="@user.Id">Show</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {

    <script>
        function approveUser(userId) {
            $.ajax({
                url: '/UserDataChangeRequest/Approve',
                method: 'POST',
                data: { id: userId },
                success: function (result) {
                    if(result){
                        alert('User approved successfully!');
                        window.location = '/UserDataChangeRequest';
                    }
                    else{
                        alert('Error approving user.');
                    }
                },
                error: function () {
                    alert('Error approving user.');
                }
            });
        }

        function rejectUser(userId) {
            $.ajax({
                url: '/UserDataChangeRequest/Reject',
                method: 'POST',
                data: { id: userId },
                success: function (result) {
                    if(result){
                        alert('User rejected successfully!');
                        window.location = '/UserDataChangeRequest';
                    }
                    else{
                        alert('Error approving user.');
                    }
                },
                error: function () {
                    alert('Error rejecting user.');
                }
            });
        }

        $('.js-delete').on('click', function () {
            var btn = $(this);
            $.ajax({
                url: '/Users/delete/' + btn.data('id'),
                method: 'DELETE',
                success: function (response) {
                    if (!response) {
                        $('#reject-alert').removeClass('d-none');
                    } else {
                        btn.closest('tr').fadeOut(300, function () { $(this).remove(); });
                        $('#alert').removeClass('d-none');
                    }
                },
                error: function () {
                    alert('This action is not allowed to you!');
                }

            });
        });

    </script>


}

