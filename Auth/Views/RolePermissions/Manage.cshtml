@using Auth.Authorization
@model List<PermissionViewModel>
@{
    ViewData["Title"] = "Manage Role Permissions";
    var role = ViewBag.Role as string;

    var groupedPermissions = Model
        .GroupBy(p => p.Name.Split('.')[0]) // Controller name
        .OrderBy(g => g.Key);
}

<h4 class="mb-4">Manage Permissions for Role: <strong>@role</strong></h4>

<form method="post">
    <input type="hidden" name="roleName" value="@role" />

    <div class="accordion" id="permissionAccordion">
        @foreach (var group in groupedPermissions)
        {
            var controllerName = group.Key;
            var collapseId = $"collapse_{controllerName}";

            <div class="accordion-item">
                <h2 class="accordion-header" id="heading_@controllerName">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                        @controllerName Controller
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="heading_@controllerName" data-bs-parent="#permissionAccordion">
                    <div class="accordion-body p-0">
                        <table class="table table-bordered mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Action</th>
                                    <th class="text-center">Assigned</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var permission in group)
                                {
                                    var index = Model.IndexOf(permission);
                                    var actionName = permission.Name.Split('.')[1];

                                    <tr>
                                        <td>@actionName</td>
                                        <td class="text-center">
                                            <input type="checkbox" name="permissions[@index].Selected" value="true" @(permission.Selected ? "checked" : "") />
                                            <input type="hidden" name="permissions[@index].Name" value="@permission.Name" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-success">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</form>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
